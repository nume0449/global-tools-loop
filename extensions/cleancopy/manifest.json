{
  "manifest_version": 3,
  "name": "CleanCopy — Copy Page as Markdown",
  "short_name": "CleanCopy",
  "version": "0.1.0",
  "description": "Copy the readable content of any page as clean Markdown — perfect for pasting into ChatGPT, Claude, or your notes. One click, no ads, no nav clutter.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Copy page as Markdown"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
